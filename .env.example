# ==============================================================================
# BUGO SYNC LIST - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development or configure in your host's
# secret manager for production. NEVER commit .env or real secrets to Git.
# ==============================================================================

# --- Runtime Environment ---
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

# --- Application URL & CORS ---
# Localhost URL in development; set to your HTTPS origin in production (e.g. https://bugo-assist.up.railway.app)
APP_URL="http://localhost:3000"
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:3000"
# Set to "true" in production behind an HTTPS reverse proxy (Nginx / Railway / Render / Cloud Run)
FORCE_HTTPS="false"

# --- Database (MySQL + Prisma ORM) ---
# Local MySQL example: mysql://bugo_user:YOUR_STRONG_PASSWORD@127.0.0.1:3306/barangay_bugo_db
# Production SSL MySQL example: mysql://user:pass@host:3306/barangay_bugo_db?sslaccept=strict
DATABASE_URL="mysql://bugo_user:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:3306/barangay_bugo_db"

# --- Authentication & Cryptographic Security (JWT, Bcrypt, HMAC) ---
# Generate strong 64-char secrets via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET"
JWT_EXPIRES_IN="2h"
BCRYPT_ROUNDS="12"
HMAC_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HMAC_SECRET"

# --- Initial Database Seeding (Used by: npm run prisma:seed) ---
# In production, override with secure passwords before running prisma:seed
SEED_ADMIN_PASSWORD="CHANGE_ME_ADMIN_INITIAL_PASSWORD"
SEED_RESIDENT_PASSWORD="CHANGE_ME_RESIDENT_INITIAL_PASSWORD"

# --- Optional AI ID Inspection (Gemini Vision) ---
# Leave blank to use the built-in server heuristic fallback
GEMINI_API_KEY=""

# --- Google Maps Platform (Bugo Disaster Hazard Map) ---
# Provisioned automatically in AI Studio or set your restricted Maps JS API key
VITE_GOOGLE_MAPS_API_KEY=""

# --- Optional Services (NOT Currently Implemented in Codebase) ---
# Enable only if you later integrate Cloudinary media storage or Firebase Cloud Messaging
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
